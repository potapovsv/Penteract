    <Formula>[Measures].[Points.Withdraw (Total)]/([Measures].[Points.Deposit (Total)] ) </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="Percent"/>
  </CalculatedMember>    

   <CalculatedMember name="Discount, % of MSRP" dimension="Measures" displayFolder="Discount Points\Discount">
    <Formula>[Measures].[Discount (Total)]/([Measures].[Revenue (Total)] + [Measures].[Discount (Total)]) </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="Percent"/>
  </CalculatedMember>
  <!-- Discount Points	Average.Purchase -->
