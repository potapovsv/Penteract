   <CalculatedMember name="Сustomer.SKU.Сount (Avg)" dimension="Measures" displayFolder="Purchase\Average.Customer">
    <Formula>[Measures].[SKU.Count (Total)]/[Measures].[Purchase.Customers.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember> 
   <CalculatedMember name="Customer.Product.Quantity (Avg)" dimension="Measures" displayFolder="Purchase\Average.Customer">
    <Formula>[Measures].[Product.Quantity (Total)]/[Measures].[Purchase.Customers.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
