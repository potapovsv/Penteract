   <Measure name="Product.Quantity (Total)" column="m__qntcheque" aggregator="sum" formatString="Standard" displayFolder="Purchase"/> 
   <Measure name="SKU.Count (Total)" column="k__goods_sk" aggregator="distinct-count" formatString="Standard" displayFolder="Purchase"/> 
   <Measure name="purch_count" column="" aggregator="count" formatString="Standard" displayFolder="Purchase"/> 



<!-- Purchase.Customers    -->
   <Measure name="Purchase.Customers.Count (Total)" column="c_personid" aggregator="distinct-count" formatString="Standard" displayFolder="Purchase.Customers"/>
   <Measure name="Purchase.Customers.Group.Count (Total)" column="c_usergroupid" aggregator="distinct-count" formatString="Standard" displayFolder="Purchase.Customers"/>
   <Measure name="Purchase.Customers.Card.Count (Total)" column="c_number" aggregator="distinct-count" formatString="Standard" displayFolder="Purchase.Customers"/>
   <Measure name="Points.Deposit (Total)" column="m__tocardamount" aggregator="sum" formatString="Standard" datatype="Numeric" displayFolder="Discount Points\Points.Deposit"/>
   <Measure name="Points.Withdraw (Total)" column="m__fromcardamount" aggregator="sum" formatString="Standard" datatype="Numeric" displayFolder="Discount Points\Points.Withdraw"/>
   <Measure name="Discount (Total)" column="m__discount" aggregator="sum" formatString="Standard" displayFolder="Discount Points\Discount"/>
<!-- Purchase.Finance -->
   <Measure name="Revenue (Total)" column="m__amtcheque" aggregator="sum" formatString="Standard" displayFolder="Purchase.Finance"/>
   <Measure name="Cost price" column="m__amountcost" aggregator="sum" formatString="Standard" displayFolder="Purchase.Finance"/>
   <CalculatedMember name="MSRP (Total)" dimension="Measures" displayFolder="Purchase.Finance">
         <Formula>[Measures].[Revenue (Total)] + [Measures].[Discount (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>   
  <CalculatedMember name="Amount (Total)" dimension="Measures" displayFolder="Purchase.Finance">
         <Formula>[Measures].[Revenue (Total)] + [Measures].[Discount (Total)] + [Measures].[Points.Withdraw (Total)]</Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>   
  <CalculatedMember name="Margin" dimension="Measures" displayFolder="Purchase.Finance">
         <Formula>[Measures].[Amount (Total)] - [Measures].[Cost price] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>   
  <CalculatedMember name="Margin %" dimension="Measures" displayFolder="Purchase.Finance">
         <Formula>([Measures].[Amount (Total)] - [Measures].[Cost price])/[Measures].[Amount (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="Percent"/>
  </CalculatedMember>   
    <CalculatedMember name="Purchase price" dimension="Measures" displayFolder="Purchase.Finance">
         <Formula>Null</Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="Percent"/>
  </CalculatedMember>   
<!-- Purchase.Finance	Average.Purchase -->
  <CalculatedMember name="Purchase.MSRP (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Purchase">
         <Formula>[Measures].[MSRP (Total)] / [Measures].[Purchase.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>   
    <CalculatedMember name="Purchase.Amount (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Purchase">
         <Formula>[Measures].[Amount (Total)] / [Measures].[Purchase.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>  
    <CalculatedMember name="Purchase.Revenue (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Purchase">
         <Formula>[Measures].[Revenue (Total)] / [Measures].[Purchase.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>    
     <CalculatedMember name="Purchase.Margin (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Purchase">
         <Formula>[Measures].[Margin] / [Measures].[Purchase.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>    
     <CalculatedMember name="Purchase.Cost price (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Purchase">
         <Formula>[Measures].[Cost price] / [Measures].[Purchase.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>   
<!-- Purchase.Finance	Average.Customer -->
   <CalculatedMember name="Customer.MSRP (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Customer">
         <Formula>[Measures].[MSRP (Total)] / [Measures].[Purchase.Customers.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>   
    <CalculatedMember name="Customer.Amount (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Customer">
         <Formula>[Measures].[Amount (Total)] / [Measures].[Purchase.Customers.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>  
    <CalculatedMember name="Customer.Revenue (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Customer">
         <Formula>[Measures].[Revenue (Total)] / [Measures].[Purchase.Customers.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>    
     <CalculatedMember name="Customer.Margin (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Customer">
         <Formula>[Measures].[Margin] / [Measures].[Purchase.Customers.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>    
     <CalculatedMember name="Customer.Cost price (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Customer">
         <Formula>[Measures].[Cost price] / [Measures].[Purchase.Customers.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>  
<!-- Purchase.Finance	Average.Unit -->
   <CalculatedMember name="Unit.MSRP (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Unit">
         <Formula>[Measures].[MSRP (Total)] / [Measures].[SKU.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>   
    <CalculatedMember name="Unit.Amount (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Unit">
         <Formula>[Measures].[Amount (Total)] / [Measures].[SKU.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>  
    <CalculatedMember name="Unit.Revenue (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Unit">
         <Formula>[Measures].[Revenue (Total)] / [Measures].[SKU.Count (Total)] </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>    
     <CalculatedMember name="Unit.Margin (Avg)" dimension="Measures" displayFolder="Purchase.Finance\Average.Unit">
