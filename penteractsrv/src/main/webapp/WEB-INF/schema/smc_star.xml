    <CalculatedMemberProperty name="FORMAT_STRING" value="#,##0.00"/>
  </CalculatedMember>  


<!--Purchase Average.Purchase -->
   <CalculatedMember name="Purchase.SKU.Сount (Avg)" dimension="Measures" displayFolder="Purchase\Average.Purchase">
    <Formula>[Measures].[SKU.Count (Total)]/[Measures].[Purchase.Count (Total)] </Formula>
