<!-- Discount Points -->

    <CalculatedMember name="Points.Deposit, % of MSRP" dimension="Measures" displayFolder="Discount Points\Points.Deposit">
    <Formula>[Measures].[Points.Deposit (Total)]/([Measures].[Revenue (Total)] + [Measures].[Discount (Total)]) </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="Percent"/>
  </CalculatedMember>      


    <CalculatedMember name="Points.Withdraw, % of MSRP" dimension="Measures" displayFolder="Discount Points\Points.Withdraw">
    <Formula>[Measures].[Points.Withdraw (Total)]/([Measures].[Revenue (Total)] + [Measures].[Discount (Total)]) </Formula>
    <CalculatedMemberProperty name="FORMAT_STRING" value="Percent"/>
  </CalculatedMember>    
